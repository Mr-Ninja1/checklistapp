{
  "expo": {
  "name": "Bravo manager",
    "slug": "bravo-manager",
    "scheme": "checklistapp",
  "icon": "./src/assets/bravo.png",
    "splash": {
      "image": "./src/assets/logo.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#185a9d"
    },
    "extra": {
      "dropboxAppKey": "fc5bqdv55hchi8e"
    },
    "android": {
      "package": "com.mrninja1.bravomanager",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/bravo.png",
        "backgroundColor": "#185a9d"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "runtimeVersion": { "policy": "sdkVersion" }
    }
  },
  "android": {
    "package": "com.mrninja1.app"
  }
}
